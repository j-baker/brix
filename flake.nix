{
  description = "brix — a bug-for-bug compatible Nix evaluator in Rust";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-26.05";
    nix-claude-code.url = "github:ryoppippi/nix-claude-code";
    nix-claude-code.inputs.nixpkgs.follows = "nixpkgs";
    crate2nix.url = "github:nix-community/crate2nix";
    crate2nix.inputs.nixpkgs.follows = "nixpkgs";
    # The Nix brix is compatible with: Determinate Nix, pinned to a release
    # tag. Its source tree is the specification (the language test corpus
    # in tests/functional/lang runs against brix, and src/libexpr is the
    # reference when the manual is silent) and its package is the oracle
    # binary the differential tests compare against. Both come from the same
    # revision, and the binary is substituted from the FlakeHub cache.
    nix-src.url = "github:DeterminateSystems/nix-src/v3.24.1";
    llm-agents.url = "github:numtide/llm-agents.nix";
    llm-agents.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs =
    {
      self,
      nixpkgs,
      nix-claude-code,
      crate2nix,
      nix-src,
      llm-agents,
      ...
    }:
    let
      systems = [
        "x86_64-linux"
        "aarch64-linux"
      ];
      forAllSystems = f: nixpkgs.lib.genAttrs systems (system: f system);
      pkgsFor =
        system:
        import nixpkgs {
          inherit system;
          config.allowUnfree = true;
          overlays = [
            nix-claude-code.overlays.default
            llm-agents.overlays.shared-nixpkgs
          ];
        };
      # The `nix` binary of the reference Nix: the oracle of the differential
      # tests, and the Nix brix hands the commands it does not implement to.
      referenceNix = pkgs: pkgs.lib.getExe nix-src.packages.${pkgs.stdenv.hostPlatform.system}.default;
      # Environment the test suites need: where the reference Nix sources
      # (language test corpus) live, and which `nix` binary is the oracle for
      # differential tests. Shared by the devshell and the Nix build so
      # `cargo test` and `nix flake check` see the same world.
      testEnv = pkgs: {
        BRIX_NIX_SRC = "${nix-src.outPath}";
        # The locked nixpkgs tree, for the corpus and benchmark tests.
        BRIX_NIXPKGS = "${nixpkgs}";
        BRIX_NIX_BIN = referenceNix pkgs;
        NIX_CONFIG = "extra-experimental-features = ca-derivations";
      };
      buildPkg =
        pkgs:
        import ./nix/package.nix {
          inherit pkgs;
          testEnv = testEnv pkgs;
          delegateNix = referenceNix pkgs;
          # Cargo.nix is committed, generated by `crate2nix generate` (the
          # CLI is in the devshell; rerun it whenever Cargo.lock changes).
          # Importing the checked-in file keeps evaluation pure: no IFD and
          # no build-time generation step.
          # brix-gc requires POPCNT on x86-64 (buildRustCrate does not read
          # .cargo/config.toml).
          cargoNix = pkgs.callPackage ./Cargo.nix {
            targetFeatures = pkgs.lib.optionals pkgs.stdenv.hostPlatform.isx86_64 [ "popcnt" ];
          };
        };
      buildOptimized =
        pkgs:
        import ./nix/pgo-bolt.nix {
          inherit pkgs;
          trainingEnv = {
            BRIX_NIXPKGS = "${nixpkgs}";
            BRIX_NIX_SRC = "${nix-src.outPath}";
          };
          delegateNix = referenceNix pkgs;
        };
      modulePackage =
        pkgs:
        if
          builtins.elem pkgs.stdenv.hostPlatform.system systems
          && pkgs.stdenv.buildPlatform == pkgs.stdenv.hostPlatform
        then
          buildOptimized pkgs
        else
          (buildPkg pkgs).brix;
    in
    {
      nixosModules.default = self.nixosModules.brix;
      nixosModules.brix = import ./nix/modules/system.nix {
        defaultPackage = modulePackage;
      };
      darwinModules.default = self.darwinModules.brix;
      darwinModules.brix = self.nixosModules.brix;
      systemManagerModules.default = self.systemManagerModules.brix;
      systemManagerModules.brix = self.nixosModules.brix;
      homeManagerModules.default = self.homeManagerModules.brix;
      homeManagerModules.brix = import ./nix/modules/home-manager.nix {
        defaultPackage = modulePackage;
      };

      packages = forAllSystems (
        system:
        let
          built = buildPkg (pkgsFor system);
        in
        {
          brix = built.brix;
          default = built.brix;
          brix-pgo-bolt = buildOptimized (pkgsFor system);
        }
      );

      # `nix build .#checks.x86_64-linux.canBuild` is the build-time CI gate
      # executed by the Trustless build runner; `tests` runs every crate's
      # test suite inside the sandbox.
      checks = forAllSystems (
        system:
        let
          built = buildPkg (pkgsFor system);
        in
        {
          canBuild = built.brix;
          pgo-bolt = self.packages.${system}.brix-pgo-bolt;
          inherit (built) tests;
          modules = import ./nix/tests/modules.nix { pkgs = pkgsFor system; };
        }
      );

      # `nix fmt` / `nix fmt -- --ci` use this. nixfmt-tree formats all
      # *.nix files in the repository tree except the generated Cargo.nix,
      # which stays byte-identical to crate2nix's output, and rustfmt the
      # Rust sources as `cargo fmt` would (the workspace's edition; each
      # file on its own, which is what `cargo fmt` does too).
      formatter = forAllSystems (
        system:
        let
          pkgs = pkgsFor system;
        in
        pkgs.nixfmt-tree.override {
          runtimeInputs = [ pkgs.rustfmt ];
          settings.formatter = {
            nixfmt.excludes = [ "Cargo.nix" ];
            rustfmt = {
              command = "rustfmt";
              options = [
                "--edition"
                "2021"
              ];
              includes = [ "*.rs" ];
            };
          };
        }
      );

      devShells = forAllSystems (
        system:
        let
          pkgs = pkgsFor system;
        in
        {
          default = pkgs.mkShell (
            {
              packages = with pkgs; [
                # nixpkgs' rustc has the standard library for
                # wasm32-unknown-unknown as well as the host's, which
                # scripts/check-wasm.sh builds for.
                rustc
                cargo
                rustfmt
                clippy
                rust-analyzer
                cargo-nextest
                nix
                jq
                # `hg`, which brix and Nix run to fetch Mercurial inputs
                # (brix-flake's native/mercurial.rs, brix-cli's
                # tests/mercurial.rs).
                mercurial
                # `unshare`, with which brix-cli's tests/offline.rs takes
                # the network away; alone, since util-linux's `su` and
                # `mount` would shadow NixOS's setuid wrappers.
                (runCommand "unshare" { } ''
                  mkdir -p $out/bin
                  ln -s ${util-linux}/bin/unshare $out/bin/unshare
                '')
                # `ssh-keygen`, which git runs to sign commits and to check
                # their signatures (tests of `verifyCommit`); alone, so that
                # the user's own `ssh` stays first on PATH.
                (runCommand "ssh-keygen" { } ''
                  mkdir -p $out/bin
                  ln -s ${openssh}/bin/ssh-keygen $out/bin/ssh-keygen
                '')
                claude-code
                pkgs.llm-agents.codex
                # Regenerates the committed Cargo.nix after dependency
                # changes: `crate2nix generate`.
                crate2nix.packages.${system}.default
                # scripts/pgo-build.sh: llvm-profdata must come from the LLVM
                # rustc itself was built with (profile formats are
                # version-specific), and BOLT from the same LLVM release.
                rustc.llvm
                pkgs."llvmPackages_${lib.versions.major rustc.llvm.version}".bolt
              ];

              RUST_SRC_PATH = "${pkgs.rustPlatform.rustLibSrc}";
              # What the package's wrapper sets, so `cargo run` hands the
              # commands brix does not implement to Nix as well.
              BRIX_DELEGATE_NIX = referenceNix pkgs;
            }
            // testEnv pkgs
          );
        }
      );

      overlays.default = final: _prev: {
        brix = (buildPkg final).brix;
        brix-pgo-bolt = buildOptimized final;
      };
    };
}
